      <aliases enabled='yes' />
      <column caption='Active in Two Semesters' datatype='string' name='[Calculation_0163603526905857]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [Curricular units 1st sem (enrolled)] &gt; 0&#13;&#10;AND [Curricular units 2nd sem (enrolled)] &gt; 0&#13;&#10;THEN &quot;Yes&quot;&#13;&#10;ELSE &quot;No&quot;&#13;&#10;END' />
      </column>
      <column caption='Dropout Rate' datatype='real' default-format='p0.00%' name='[Calculation_0163603527471106]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(&#13;&#10;    IF [Target] = &quot;Dropout&quot;&#13;&#10;    THEN 1&#13;&#10;    ELSE 0&#13;&#10;    END&#13;&#10;)&#13;&#10;/&#13;&#10;COUNT([Target])' />
      </column>
      <column caption='Student Count' datatype='integer' name='[Calculation_0163603527639043]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNT([Target])' />
      </column>
      <column caption='Age Group' datatype='string' name='[Calculation_0163603543207941]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [Age at enrollment] &lt;= 20 THEN &quot;&lt;=20&quot;&#13;&#10;ELSEIF [Age at enrollment] &lt;= 25 THEN &quot;21-25&quot;&#13;&#10;ELSEIF [Age at enrollment] &lt;= 30 THEN &quot;26-30&quot;&#13;&#10;ELSE &quot;31+&quot;&#13;&#10;END' />
      </column>
      <column caption='High Risk Students' datatype='integer' name='[Calculation_0163603547500551]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(&#13;&#10;    IF [Calculation_1655090549518345] = &quot;High&quot;&#13;&#10;    THEN 1&#13;&#10;    ELSE 0&#13;&#10;    END&#13;&#10;)' />
      </column>
      <column caption='Average Grade' datatype='real' name='[Calculation_1655090541445120]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='([Curricular units 1st sem (grade)] + [Curricular units 2nd sem (grade)]) / 2' />
      </column>
      <column caption='Overall Approval Rate' datatype='real' default-format='p0.0%' name='[Calculation_1655090542120963]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF ([Curricular units 1st sem (enrolled)] + [Curricular units 2nd sem (enrolled)]) &gt; 0 THEN&#13;&#10;    ([Curricular units 1st sem (approved)] + [Curricular units 2nd sem (approved)])&#13;&#10;    /&#13;&#10;    ([Curricular units 1st sem (enrolled)] + [Curricular units 2nd sem (enrolled)])&#13;&#10;ELSE&#13;&#10;    0&#13;&#10;END' />
      </column>
      <column caption='Total Failed Units' datatype='integer' name='[Calculation_1655090543005700]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='([Curricular units 1st sem (evaluations)] - [Curricular units 1st sem (approved)])&#13;&#10;+&#13;&#10;([Curricular units 2nd sem (evaluations)] - [Curricular units 2nd sem (approved)])' />
      </column>
      <column caption='Grade Improvement' datatype='real' name='[Calculation_1655090543550469]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[Curricular units 2nd sem (grade)] - [Curricular units 1st sem (grade)]' />
      </column>
      <column caption='Academic Risk' datatype='string' name='[Calculation_1655090549518345]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [Calculation_1655090541445120] &lt; 10&#13;&#10;AND [Calculation_1655090542120963] &lt; 0.50&#13;&#10;THEN &quot;High&quot;&#13;&#10;&#13;&#10;ELSEIF [Calculation_1655090541445120] &lt; 12&#13;&#10;OR [Calculation_1655090542120963] &lt; 0.70&#13;&#10;THEN &quot;Medium&quot;&#13;&#10;&#13;&#10;ELSE &quot;Low&quot;&#13;&#10;END' />
